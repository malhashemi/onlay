# Build-time settings for the clients, read from a `.env` beside this file.
#
# Copy to `.env` (gitignored) and keep only the lines you need. Every value here
# is public (origins, versions, a test switch): never put a secret in this file.
# The Worker's secrets live in packages/server/.dev.vars (see .dev.vars.example).
#
# Which commands read it. Each package script names this file with
# `bun --env-file=../../.env`, so it applies however the script is started
# (`bun run build:ext` from the root, or `bun run build` in the package):
#   bun run build:ext, build:ext:release, build:ext:store   packages/extension
#   bun run build:site, and build:web, which runs it         packages/site
#   bun run --filter @onlay/site preview                     packages/site
#   bun run build:stamp:tarball                              packages/stamp
# Nothing else reads it: not the web app build, the Worker, wrangler or the tests.
# A variable set in the shell wins over this file, and the e2e harness sets every
# one it needs, so a `.env` never changes an e2e run. CI never has one.
#
# Release packages built on your machine DO take these values, except that the
# extension's release builds (build:ext:release, build:ext:store) refuse an
# http: or loopback origin: with the local values below they fail on purpose,
# and `bun run build:ext` is the build for a local server. Each build prints
# what it baked in ("built dist/ <version> for <origin> (site <origin>)",
# "built packages/site/dist/ (service <origin>, ...)", "packed @onlay/stamp
# <version>"): check those lines, or move `.env` aside, before you ship a package.

# The service the extension talks to (packages/extension/scripts/build.ts).
# Default: https://app.onlay.dev. For the local stack: http://localhost:8787.
ONLAY_SERVER_ORIGIN=http://localhost:8787

# The public site the extension links to and lets ask `onlay-ping`
# (packages/extension/scripts/build.ts). Default: https://onlay.dev with the
# default service, otherwise ONLAY_SERVER_ORIGIN (one origin, as locally).
ONLAY_SITE_ORIGIN=http://localhost:8787

# The service the landing page links to (packages/site/src/config.ts).
# Default: https://app.onlay.dev. `bun run --filter @onlay/server dev` sets it
# to http://localhost:8787 itself.
ONLAY_SERVICE_ORIGIN=http://localhost:8787

# The extension's version (packages/extension/scripts/manifest.ts): one to four
# integers 0-65535. Default: 0.0.0. CI sets 0.2.<run number>.
ONLAY_EXTENSION_VERSION=0.0.0

# The stamp tarball's version (packages/stamp/scripts/tarball-manifest.ts),
# semver. Default: 0.0.0. CI sets 0.2.<run number>.
ONLAY_STAMP_VERSION=0.0.0

# The overlay's shadow root (packages/extension/scripts/build.ts): closed (the
# default, and the only value a NODE_ENV=production build accepts) or open (e2e
# builds only, so Playwright can reach into it).
ONLAY_SHADOW_MODE=closed

# The landing page preview's port (packages/site/scripts/preview.ts). Default: 4173.
PORT=4173
